# slack-inbox-to-notion — 設定値の雛形
#
#   cp .env.example .env.local
#
# としてコピーし、.env.local の <...> の箇所だけ実値に置き換えてください。
# そのあと `npm run props:gen` が .env.local を読み、GAS のスクリプト プロパティを
# 一括設定する使い捨てファイルを生成します(設定画面に手打ちする必要はありません)。
#
# ・.env.local は .gitignore 済みです。コミットされません。
# ・このファイル(.env.example)には実値を書かないでください。
# ・placeholder は必ず <説明文> の形にしてください。xoxb-000000-… のように
#   本物のトークンの「形」を真似ると、GitHub の push protection がダミーでも
#   秘密情報とみなして push を拒否します(実際にブロックされました)。

# ===== 人間が実値を入れる必要があるもの(4件) =====

# Slack App の Bot User OAuth Token。「xoxb-」で始まる長い文字列。
# Slack App 管理画面 → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=<SLACK_BOT_TOKEN>

# Notion インテグレーションの Internal Integration Token。
# https://www.notion.so/profile/integrations で作成
NOTION_API_TOKEN=<NOTION_API_TOKEN>

# 登録先の Notion タスクDB の ID(DB の URL に含まれる 32 桁の16進)
# https://www.notion.so/<workspace>/<ここが database id>?v=...
NOTION_TASK_DATABASE_ID=<NOTION_TASK_DATABASE_ID>

# Web App の Request URL に付ける共有シークレット(設定推奨)。
# GAS は HTTP ヘッダを読めず Slack 署名検証ができないため、これが唯一の入口制限。
#
#   プロパティ名 : REQUEST_SECRET   ← GAS のスクリプト プロパティ
#   URLのクエリ名: ?secret=         ← Slack の Request URL
#   (名前は違うが、"値" が一致していればよい)
#
# 値は GAS エディタで testGenerateSecret() を実行すると生成できます(英数字のみ・64桁)。
# & ? # / や空白を含めないこと(URL のクエリとして壊れます)。16文字以上。
REQUEST_SECRET=<REQUEST_SECRET>

# ===== 確定済みの値(そのままで OK) =====

# 「担当者」に入れる Notion ユーザーの UUID(須原弘之さん)
NOTION_ASSIGNEE_USER_ID=101ad74a-c85a-4070-89d3-b37cd3c2c4af

# このユーザーが押した📥だけを拾う(須原弘之さんの Slack ユーザーID)
ALLOWED_SLACK_USER_ID=U0BHT8ZB4

# 対象リアクションの絵文字名(コロン無し)
TARGET_REACTION=inbox_tray

# 対象チャンネルの ID(#6-attracting)
TARGET_CHANNEL_ID=C06F5DJ74UU

# Notion の「テキスト」に書くチャンネル表示名。conversations.info を呼ばずに済ませ、
# channels:read スコープを増やさないための項目。
TARGET_CHANNEL_NAME=#6-attracting

# ===== 任意(未設定なら GAS 側の既定値が使われる) =====

# タイトルに載せる本文の文字数。既定: 40
# TITLE_BODY_LENGTH=40

# 「ステータス」に入れる値。既定: INBOX
# NOTION_STATUS_VALUE=INBOX

# 「担当者」が people 型でなく select / テキスト型だった場合に入れる名前。既定: 須原弘之
# NOTION_ASSIGNEE_NAME=須原弘之

# Notion API のバージョン。既定: 2022-06-28
# NOTION_VERSION=2022-06-28

# Notion のプロパティ名。DB 側の名前を変えたときだけ設定する。
# PROP_TITLE=名前
# PROP_STATUS=ステータス
# PROP_ASSIGNEE=担当者
# PROP_TEXT=テキスト
# PROP_SLACK_URL=Slackリンク

# ===== テスト用(テストが終わったら消してよい) =====

# testDryRun() / testRegister() が読む Slack メッセージの permalink
# TEST_MESSAGE_URL=<Slackメッセージのpermalink>
