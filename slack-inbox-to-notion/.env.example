# slack-inbox-to-notion — スクリプト プロパティ雛形
#
# このファイルは GAS から読み込まれません。「GAS の
# 『プロジェクトの設定 → スクリプト プロパティ』に何を入れるか」の一覧です。
# ここに実値を書かないでください(実値は GAS の画面に直接入力する)。
# 値はすべて placeholder です。

# ===== 必須(7件) =====

# Slack App の Bot User OAuth Token。xoxb- で始まる。
# Slack App 管理画面 → OAuth & Permissions → Bot User OAuth Token
# (値は「xoxb-」で始まる長い文字列。ここには貼らず GAS の画面に直接入力する)
SLACK_BOT_TOKEN=<ここに Bot User OAuth Token>

# 注: このファイルにトークンの「形」に見える文字列を書くと、GitHub の
# push protection がダミーでも秘密情報とみなして push を拒否します。
# placeholder は必ず <山括弧の説明文> の形にしてください。

# Notion インテグレーションのトークン。ntn_ または secret_ で始まる。
# https://www.notion.so/profile/integrations で作成
NOTION_API_TOKEN=<ここに Internal Integration Token>

# 登録先の Notion タスクDB の ID(DB の URL に含まれる 32 桁の16進)
# https://www.notion.so/<workspace>/<ここが database id>?v=...
NOTION_TASK_DATABASE_ID=00000000000000000000000000000000

# 「担当者」に入れる Notion ユーザーの UUID(須原弘之さん)
# 取得方法は README「担当者の Notion ユーザーIDを調べる」を参照
NOTION_ASSIGNEE_USER_ID=00000000-0000-0000-0000-000000000000

# このユーザーが押した📥だけを拾う(須原弘之さんの Slack ユーザーID)
ALLOWED_SLACK_USER_ID=U0BHT8ZB4

# 対象リアクションの絵文字名(コロン無し)
TARGET_REACTION=inbox_tray

# 対象チャンネルの ID。#6-attracting は C06F5DJ74UU
TARGET_CHANNEL_ID=C06F5DJ74UU

# ===== 任意(未設定なら既定値が使われる。後方互換) =====

# Web App の Request URL に付ける共有シークレット。
# GAS は HTTP ヘッダを読めず Slack 署名検証ができないため、これが唯一の入口制限。
# 設定したら Slack の Request URL を .../exec?key=<この値> にすること。
# 既定: 空(=照合しない)
# REQUEST_SECRET=

# Notion の「テキスト」に書くチャンネル表示名。conversations.info を呼ばずに済ませ、
# channels:read スコープを増やさないための項目。既定: 空(=チャンネルIDのみ表示)
# TARGET_CHANNEL_NAME=#6-attracting

# タイトルに載せる本文の文字数。既定: 40
# TITLE_BODY_LENGTH=40

# 「ステータス」に入れる値。既定: INBOX
# NOTION_STATUS_VALUE=INBOX

# 「担当者」が people 型でなく select / テキスト型だった場合に入れる名前。既定: 須原弘之
# NOTION_ASSIGNEE_NAME=須原弘之

# Notion API のバージョン。既定: 2022-06-28
# NOTION_VERSION=2022-06-28

# Notion のプロパティ名。DB 側の名前を変えたときだけ設定する。
# PROP_TITLE=名前
# PROP_STATUS=ステータス
# PROP_ASSIGNEE=担当者
# PROP_TEXT=テキスト
# PROP_SLACK_URL=Slackリンク

# ===== テスト用(テストが終わったら消してよい) =====

# testDryRun() / testRegister() が読む Slack メッセージの permalink
# TEST_MESSAGE_URL=https://<workspace>.slack.com/archives/C06F5DJ74UU/p1753800000123456
